{
  "realm": "edulage",
  "enabled": true,
  "displayName": "EduLage",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "clients": [
    {
      "clientId": "openedx",
      "name": "Open edX (learn/studio)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://learn.edulage.org/*",
        "https://unia.learn.edulage.org/*",
        "https://unib.learn.edulage.org/*"
      ],
      "webOrigins": [
        "https://learn.edulage.org"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "post.logout.redirect.uris": "https://learn.edulage.org/*##https://edulage.org/*"
      },
      "protocolMappers": [
        {
          "name": "edulage_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "edulage_roles",
            "claim.name": "edulage_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "edulage_status",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "edulage_status",
            "claim.name": "edulage_status",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
